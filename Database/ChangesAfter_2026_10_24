	[ClientID] [int] NULL,
	[Leaves] [tinyint] NOT NULL,
	[BookNumber] [varchar](20) NOT NULL,
	[StartNumber] [varchar](20) NOT NULL,
	[EndNumber] [varchar](20) NOT NULL,
